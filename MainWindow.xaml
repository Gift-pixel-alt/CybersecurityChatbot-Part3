<Window x:Class="CybersecurityChatbot_Part2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Assistant"
        Height="750"
        Width="1000"
        MinHeight="600"
        MinWidth="800"
        WindowStartupLocation="Manual"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        AllowsTransparency="False">


    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Padding="15"
                CornerRadius="10"
                Background="#172554">

            <StackPanel>

                <TextBlock Text="🔐 CYBERSECURITY AWARENESS ASSISTANT"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Stay Safe • Think Before You Click"
                           Foreground="#BFDBFE"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,10"/>

                <TextBlock Text="╔════════════════════════════╗&#10;║     CYBERSECURITY          ║&#10;╚════════════════════════════╝"
                           Foreground="#67E8F9"
                           FontSize="14"
                           FontFamily="Consolas"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>

                <TextBlock Text="🔒  SECURE • ALERT • PROTECTED  🔒"
                           Foreground="White"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>

            </StackPanel>

        </Border>

        <!-- WELCOME MESSAGE -->
        <Border Grid.Row="1"
                Margin="0,10,0,0"
                Padding="10"
                Background="#E0F2FE"
                CornerRadius="8">

            <TextBlock Text="👋 Welcome! Enter your name below to begin your cybersecurity awareness session."
                       FontSize="14"
                       Foreground="#0F172A"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"/>

        </Border>

        <!-- CHAT AREA -->
        <Grid Grid.Row="2"
              Margin="0,15,0,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Chat Area -->
            <Border Grid.Column="0"
                    Padding="15"
                    BorderBrush="#94A3B8"
                    BorderThickness="1"
                    CornerRadius="10"
                    Background="#F8FAFC">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <TextBlock x:Name="ChatDisplay"
                               FontSize="16"
                               TextWrapping="Wrap"
                               Foreground="#1E293B"
                               LineHeight="28"/>

                </ScrollViewer>

            </Border>

            <!-- RIGHT SIDE PANEL -->
            <ScrollViewer Grid.Column="1"
                          Margin="15,0,0,0"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <!-- CYBERSECURITY TIPS -->
                    <Border Padding="15"
                            Background="#172554"
                            CornerRadius="10">

                        <StackPanel>

                            <TextBlock Text="🛡️ CYBERSECURITY TIPS"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,15"/>

                            <TextBlock Text="🔑 Use strong, unique passwords."
                                       Foreground="White"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="🔐 Never share your OTP or PIN."
                                       Foreground="White"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="🔗 Check links before clicking."
                                       Foreground="White"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="💻 Keep your software updated."
                                       Foreground="White"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="⚠️ Be careful with suspicious messages."
                                       Foreground="White"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="🌐 Avoid suspicious downloads."
                                       Foreground="White"
                                       FontSize="14"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>

                    <!-- SECURITY TASK LIST -->
                    <Border Margin="0,15,0,0"
                            Padding="15"
                            Background="#F1F5F9"
                            BorderBrush="#94A3B8"
                            BorderThickness="1"
                            CornerRadius="10">

                        <StackPanel>

                            <TextBlock Text="📋 SECURITY TASKS"
                                       Foreground="#172554"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="Create practical cybersecurity tasks and track your progress."
                                       Foreground="#475569"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>

                            <TextBox x:Name="TaskInput"
                                     Height="35"
                                     Padding="8"
                                     ToolTip="Enter a cybersecurity task"/>

                            <Button Content="ADD TASK"
                                    Height="35"
                                    Margin="0,8,0,8"
                                    Background="#2563EB"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="AddTaskButton_Click"/>

                            <ListBox x:Name="TaskListBox"
                                     Height="150"
                                     Margin="0,0,0,8"/>

                            <StackPanel>

                                <StackPanel Orientation="Horizontal">

                                    <Button Content="COMPLETE"
                                            Width="100"
                                            Height="35"
                                            Margin="0,0,5,5"
                                            Background="#16A34A"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Click="CompleteTaskButton_Click"/>

                                    <Button Content="REMOVE"
                                            Width="90"
                                            Height="35"
                                            Margin="0,0,0,5"
                                            Background="#DC2626"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Click="RemoveTaskButton_Click"/>

                                </StackPanel>

                                <Button Content="CLEAR ALL"
                                        Width="195"
                                        Height="35"
                                        Background="#64748B"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="ClearAllTasksButton_Click"/>

                            </StackPanel>

                            <TextBlock x:Name="TaskStatusText"
                                       Text="Tasks: 0 | Completed: 0"
                                       Foreground="#172554"
                                       FontWeight="Bold"
                                       Margin="0,10,0,0"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </ScrollViewer>

        </Grid>

        <!-- INPUT AREA -->
        <Grid Grid.Row="3">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="UserInput"
                     Grid.Column="0"
                     Height="45"
                     FontSize="16"
                     Padding="10"
                     VerticalContentAlignment="Center"
                     ToolTip="Type your cybersecurity question"
                     KeyDown="UserInput_KeyDown"/>

            <Button x:Name="SendButton"
                    Grid.Column="1"
                    Content="SEND"
                    Height="45"
                    Margin="10,0,0,0"
                    FontWeight="Bold"
                    Background="#2563EB"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="SendButton_Click"/>

            <Button x:Name="ClearButton"
                    Grid.Column="2"
                    Content="CLEAR"
                    Height="45"
                    Margin="10,0,0,0"
                    FontWeight="Bold"
                    Background="#64748B"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="ClearButton_Click"/>

        </Grid>

        <!-- TOPIC BUTTONS -->
        <WrapPanel Grid.Row="4"
                   HorizontalAlignment="Center"
                   Margin="0,12,0,0">

            <Button Content="Phishing"
                    Tag="What is phishing?"
                    Click="TopicButton_Click"
                    Margin="5"
                    Padding="15,8"/>

            <Button Content="Passwords"
                    Tag="How should I protect my password?"
                    Click="TopicButton_Click"
                    Margin="5"
                    Padding="15,8"/>

            <Button Content="Scams"
                    Tag="How can I avoid online scams?"
                    Click="TopicButton_Click"
                    Margin="5"
                    Padding="15,8"/>

            <Button Content="Safe Browsing"
                    Tag="How can I browse safely?"
                    Click="TopicButton_Click"
                    Margin="5"
                    Padding="15,8"/>

            <Button Content="Malware"
                    Tag="What is malware?"
                    Click="TopicButton_Click"
                    Margin="5"
                    Padding="15,8"/>

            <Button Content="Privacy"
                    Tag="How can I protect my privacy?"
                    Click="TopicButton_Click"
                    Margin="5"
                    Padding="15,8"/>

        </WrapPanel>

    </Grid>

</Window>